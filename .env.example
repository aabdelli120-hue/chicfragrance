# Google Sheets — server-side only. Never expose these to the browser.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Optional layout overrides. Defaults: COMMANDES!A:K and DEPENSES!A:K
GOOGLE_ORDERS_SHEET=COMMANDES
GOOGLE_ORDERS_RANGE=A:K
GOOGLE_EXPENSES_SHEET=DEPENSES
GOOGLE_EXPENSES_RANGE=A:K

# Optional: show clearly labeled demo data when Sheets is not configured.
# Never mixed with live Google Sheets data.
CHIC_ALLOW_DEMO_DATA=false
